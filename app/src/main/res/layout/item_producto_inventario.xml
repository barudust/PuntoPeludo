<?xml version="1.0" encoding="utf-8"?>
<!-- CAMBIO: Convertido a ConstraintLayout para mayor flexibilidad y rendimiento -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- 1. Icono del Producto -->
        <ImageView
            android:id="@+id/ivProductIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/box_open_2_svgrepo_com"
            app:tint="@color/azul_medio"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:contentDescription="Icono de producto" />

        <!-- 2. Nombre del Producto (Principal) -->
        <TextView
            android:id="@+id/tvNombreProd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="@color/azul_oscuro"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/chipStock"
            app:layout_constraintStart_toEndOf="@id/ivProductIcon"
            app:layout_constraintTop_toTopOf="@id/ivProductIcon"
            tools:text="Nupec Adulto Razas Pequeñas 8kg" />

        <!-- 3. Precio (Secundario, pero importante) -->
        <TextView
            android:id="@+id/tvPrecioProd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/azul_medio"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/tvNombreProd"
            app:layout_constraintTop_toBottomOf="@id/tvNombreProd"
            tools:text="$1,450.00" />

        <!-- 4. Chip de Stock (Indicador de estado) -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipStock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:chipBackgroundColor="#4CAF50"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="15 pzas" />

        <!-- 5. Barra divisoria sutil -->
        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#1F000000"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvNombreProd"
            app:layout_constraintTop_toBottomOf="@id/tvPrecioProd" />

        <!-- 6. Información Adicional (Marca y Categoría) -->
        <TextView
            android:id="@+id/tvMarcaProd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#757575"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@id/divider"
            app:layout_constraintTop_toBottomOf="@id/divider"
            tools:text="Marca: Nupec" />

        <TextView
            android:id="@+id/tvCategoriaProd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="#757575"
            android:textSize="12sp"
            android:textStyle="italic"
            app:layout_constraintBottom_toBottomOf="@id/tvMarcaProd"
            app:layout_constraintStart_toEndOf="@id/tvMarcaProd"
            app:layout_constraintTop_toTopOf="@id/tvMarcaProd"
            tools:text="Categoría: Perro" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
