<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filtrar Inventario"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="16dp"/>

        <TextView
            style="@style/TituloFiltro"
            android:text="🐾 Especie"/>

        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupEspecie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEspTodos"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Todos"
                    android:checked="true"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEspPerro"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Perro"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEspGato"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gato"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEspGanado"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ganado"/>
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <View style="@style/SeparadorFiltro"/>

        <TextView
            style="@style/TituloFiltro"
            android:text="📦 Categoría"/>

        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupCategoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCatTodos"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Todas"
                    android:checked="true"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCatAlimento"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alimento"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCatAccesorio"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Accesorio"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCatFarmacia"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Farmacia"/>
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <View style="@style/SeparadorFiltro"/>

        <TextView
            style="@style/TituloFiltro"
            android:text="⚠️ Estado / Tipo"/>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="false">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBajoStock"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚨 Bajo Stock"
                android:textColor="#D32F2F"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipGranel"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚖️ Solo Granel"/>
        </com.google.android.material.chip.ChipGroup>

        <View style="@style/SeparadorFiltro"/>

        <TextView
            style="@style/TituloFiltro"
            android:text="🔃 Ordenar por"/>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupOrden"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipOrdenDefecto"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Normal"
                android:checked="true"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPrecioMenor"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💲 Precio Menor"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPrecioMayor"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💰 Precio Mayor"/>
        </com.google.android.material.chip.ChipGroup>

    </LinearLayout>
</ScrollView>